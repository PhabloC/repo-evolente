{
  "name": "scaffolds-quality-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm --prefix backend run start:dev\" \"npm --prefix front-end run dev\"",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint:staged": "lint-staged",
    "review:staged": "node scripts/review-guard.js --staged",
    "review:pr": "node scripts/review-guard.js --pr",
    "quality:lint": "node scripts/run-stack-script.js lint",
    "quality:typecheck": "node scripts/run-stack-script.js typecheck",
    "quality:test": "node scripts/run-stack-script.js test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  }
}
