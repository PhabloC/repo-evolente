{
  "version": "1.0.0",
  "name": "orchestrated-scaffold",
  "managedPaths": [
    ".agents/skills/**",
    "AGENTS.md",
    "GUIDE.md",
    "GUIDE-FLUXOGRAMA.mmd",
    ".github/workflows/**",
    "README.md",
    ".scaffold-version"
  ],
  "ignoreDuringUpgrade": [
    "tasks/**",
    "front-end/**",
    "next-js/**",
    "backend/**",
    "mobile/**",
    "requirements/**",
    "design-system/front/**",
    "design-system/mobile/**",
    "contracts/openapi.yaml",
    "**/*.example",
    ".git/**"
  ],
  "postUpgradeCommands": [
    "npm install --silent"
  ]
}
